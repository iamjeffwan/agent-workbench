{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/inject-shell-trace.mjs",
        "matcher": "Shell",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/record-agent-tool.mjs",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node .cursor/hooks/record-agent-tool.mjs",
        "timeout": 10
      }
    ]
  }
}
