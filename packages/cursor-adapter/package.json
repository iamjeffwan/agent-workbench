{
  "name": "@agent-workbench/cursor-adapter",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only Cursor agent-transcripts adapter for Agent Workbench verification.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cursor-adapt": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "adapt": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
