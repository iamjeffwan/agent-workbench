{
  "name": "@agent-workbench/review",
  "version": "0.0.1",
  "private": true,
  "description": "Evidence-backed review domain model for Agent Workbench.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/review-case-record.schema.json",
    "./evidence-schema": "./schema/review-evidence-package.schema.json",
    "./model-output-schema": "./schema/review-model-output.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@agent-workbench/codex-cli-model": "workspace:*",
    "@agent-workbench/local-database": "workspace:*",
    "@agent-workbench/observation-schema": "workspace:*",
    "@agent-workbench/project-observation": "workspace:*",
    "@agent-workbench/security": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
